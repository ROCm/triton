  %45 = fadd float %44, 1.000000e+00, !dbg !23
  %46 = fmul float %45, 0x3F20000000000000, !dbg !24
  %47 = tail call noundef float @llvm.floor.f32(float %46), !dbg !25
  %48 = fadd float %47, 1.000000e+00, !dbg !26
  %49 = tail call float @llvm.log.f32(float %48), !dbg !27
  %50 = insertelement <2 x float> poison, float %42, i64 0, !dbg !28
  %51 = insertelement <2 x float> %50, float %49, i64 1, !dbg !28
  %52 = fmul <2 x float> %51, splat (float 0x3FB99999A0000000), !dbg !28
