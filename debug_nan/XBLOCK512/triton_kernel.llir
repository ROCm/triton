  %58 = and <2 x i32> %57, splat (i32 1), !dbg !21
  %59 = add <2 x i32> %56, splat (i32 32767), !dbg !21
  %60 = add <2 x i32> %59, %58, !dbg !21
  %61 = lshr <2 x i32> %60, splat (i32 16), !dbg !21
  %62 = trunc nuw <2 x i32> %61 to <2 x i16>, !dbg !21
  %63 = bitcast <2 x i16> %62 to <2 x bfloat>, !dbg !21
  %64 = select <2 x i1> %55, <2 x bfloat> splat (bfloat 0xR7FFF), <2 x bfloat> %63, !dbg !21
