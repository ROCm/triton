define amdgpu_kernel void @triton_kernel(ptr addrspace(1) inreg readonly captures(none) %0, ptr addrspace(1) inreg readonly captures(none) %1, ptr addrspace(1) inreg writeonly captures(none) %2, ptr addrspace(1) inreg readnone captures(none) %3, i32 inreg %4, ptr addrspace(1) inreg readnone captures(none) %5) local_unnamed_addr #0 !dbg !6 {
